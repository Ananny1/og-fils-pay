# Production images for the hosted stack (ops/docker-compose.prod.yml).
# Build from the repo root. Two final targets:
#   --target app   api, reporting, migrate and seed-once: plain JS bundles
#                  (no tsx / TypeScript at runtime) + production node_modules
#   --target web   nginx serving the static shop app (/) and staff console
#                  (/admin/) and proxying /v1 to the api
# The laptop stack keeps using ops/Dockerfile.node.

# ---- all dependencies (build tools; argon2 may need to compile) ----
FROM node:22-bookworm-slim AS deps
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY packages/theme/package.json packages/theme/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/

FROM deps AS alldeps
RUN npm ci --no-audit --no-fund && npm cache clean --force

# ---- production dependencies only (lockfile-pinned) ----
FROM deps AS proddeps
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

# ---- build: bundle the services, build both SPAs ----
FROM alldeps AS build
COPY . .
RUN sh ops/prod/bundle.sh /app/dist
RUN cd apps/web && VITE_API_BASE_URL="" npx vite build --outDir /app/static/web --emptyOutDir
RUN cd apps/admin && VITE_ADMIN_API_BASE_URL="" VITE_WEB_BASE_URL="/" \
    npx vite build --base=/admin/ --outDir /app/static/admin --emptyOutDir

# ---- app runtime ----
FROM node:22-bookworm-slim AS app
ENV NODE_ENV=production
WORKDIR /app
COPY --from=proddeps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# KYC uploads (KYC_UPLOAD_DIR=./data/kyc) live on a volume owned by `node`.
RUN mkdir -p /app/data/kyc && chown -R node:node /app/data
USER node
EXPOSE 3000
CMD ["node", "dist/api.mjs"]

# ---- static front ends + reverse proxy ----
FROM nginx:1.27-alpine AS web
# One worker: nginx's default is one per host core, and many workers under a
# small CPU cap spend their quota fighting each other (CAP-1).
RUN sed -i 's/^worker_processes .*/worker_processes 1;/' /etc/nginx/nginx.conf
# HOST-2: room for 4096 open connections (default 1024). Clients that trickle
# their headers are not counted by any per-IP limit until the headers are in
# (client_header_timeout 10s drops them), so this is what they fill first.
RUN sed -i 's/^\( *\)worker_connections .*/\1worker_connections 4096;/' /etc/nginx/nginx.conf
COPY ops/prod/nginx.conf /etc/nginx/conf.d/default.conf
COPY ops/prod/security-headers.conf /etc/nginx/snippets/security-headers.conf
# SEC-5 edge rules, included by nginx.conf (HOST-2).
COPY ops/nginx/security.conf ops/nginx/security-server.conf /etc/nginx/filspay/
COPY --from=build /app/static/web /usr/share/nginx/html
COPY --from=build /app/static/admin /usr/share/nginx/html/admin
