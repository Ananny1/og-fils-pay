# Copy to ops/.env.prod (git-ignored, docker-ignored), fill in, then
#   chmod 600 ops/.env.prod
# Used twice by ops/docker-compose.prod.yml: `--env-file` for ${...} in the
# compose file, and `env_file:` for the api / settlement / reporting containers.
# Generate every secret on the server; never reuse the dev values.

# --- public names ----------------------------------------------------------
WEB_DOMAIN=pay.example.com
ADMIN_DOMAIN=admin.pay.example.com
WEB_PUBLIC_URL=https://pay.example.com
# Where hosted checkout lives (used in payment-link URLs the API returns).
CHECKOUT_BASE_URL=https://pay.example.com
# off until the first certificate exists (docs/ops/DEPLOY.md step 6), then on.
TLS=off

# --- secrets -----------------------------------------------------------------
# URL-safe, it goes into DATABASE_URL:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Shared by api (client) and settlement (server):  openssl rand -hex 32
SETTLEMENT_INTERNAL_TOKEN=
# Exactly 32 random bytes, base64:  openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Shared with the acquirer:  openssl rand -hex 32
ACQUIRER_CALLBACK_SIGNING_SECRET=
ACQUIRER_CALLBACK_REQUIRE_SIGNATURE=true

# --- production behaviour ------------------------------------------------------
OTP_DEV_EXPOSE=false
# Cookies are Secure by default in production. Only set false for a local
# HTTP-only rehearsal; never on a public box.
# COOKIE_SECURE=false

# --- capacity knobs (defaults are the tested values, docs/ops/CAPACITY.md) ---
# API_PG_POOL_MAX=20
# API_MAX_IN_FLIGHT=64
# NGINX_API_RATE=20r/s
# NGINX_API_BURST=40
# NGINX_AUTH_RATE=10r/m
# NGINX_AUTH_BURST=5
# NGINX_CONN_PER_IP=30

# --- host ports (defaults 80/443) -----------------------------------------
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
