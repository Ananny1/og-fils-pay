# Hosted stack settings. Copy to ops/.env.prod (git-ignored), fill every
# "change-me", then:
#   docker compose --env-file ops/.env.prod -f ops/docker-compose.prod.yml up -d --build
# This file is used twice: by compose itself (the ${...} values in the
# compose file) and as env_file for every service.

NODE_ENV=production
OTP_DEV_EXPOSE=false

# Public HTTP port on the host (nginx). The only published port.
PUBLIC_PORT=80

# Database password (Postgres is never published to the internet).
# Letters and digits only (it is placed inside a URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Shared by api (client) and settlement (server); must match. openssl rand -hex 32
SETTLEMENT_INTERNAL_TOKEN=change-me

# base64 of exactly 32 random bytes: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=

ACQUIRER_CALLBACK_SIGNING_SECRET=change-me

# Session cookies are Secure in production. Keep true when TLS is in front
# (Cloudflare / Caddy / a load balancer). Set false ONLY for a plain-http test.
COOKIE_SECURE=true

# Where checkout links point (the public URL of this server).
CHECKOUT_BASE_URL=https://filspay.example.com

# The api sits behind nginx (the only published port), which overwrites
# X-Forwarded-For with the real client IP (HOST-2). true = the SEC-1 login
# limiter and the audit log see each client's own IP, not nginx's. Safe only
# because the api port is never published (ops/docker-compose.prod.yml).
TRUST_PROXY=true

# Passwords for the users the first boot seeds (seed-once). Required when
# NODE_ENV=production: 12+ characters, different from each other and from the
# dev values committed in db/seed/generate.ts, or the seed refuses to run.
# Shop users (owner@alpharetail.example, ...) get SEED_USER_PASSWORD; staff
# (support@ / finance@ / superadmin@filspay.test) get SEED_ADMIN_PASSWORD.
SEED_USER_PASSWORD=change-me
SEED_ADMIN_PASSWORD=change-me

# Load shedding (CAP-2, tuned in docs/challenge/CAPACITY.md). Optional; the
# compose file has the measured defaults.
# API_MAX_IN_FLIGHT=24
# PG_POOL_MAX=16
# PG_POOL_CONNECTION_TIMEOUT_MS=2000

# Login codes by email (ENH-001). Without SMTP_HOST nobody can receive a
# login code on a hosted box. Gmail: an account with 2-Step Verification and
# an app password (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# The Gmail address that sends the codes.
SMTP_USER=
# Gmail app password (16 characters); never commit.
SMTP_PASSWORD=
MAIL_FROM="FilsPay <same-gmail-address@gmail.com>"

# Dashboard AI assistant (Sayed). Paste the key only into the real, git-ignored
# env file on the server; never commit it. Empty = assistant switched off (503).
ANTHROPIC_API_KEY=
# Hard limits: reply size, input size, history, data lookups, effort.
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_MAX_MESSAGE_CHARS=2000
ASSISTANT_MAX_HISTORY=12
ASSISTANT_MAX_TOOL_ROUNDS=3
ASSISTANT_EFFORT=low
# Paid AI calls per merchant: per minute and per day (ENH-009).
ASSISTANT_PER_MINUTE=6
ASSISTANT_PER_DAY=100
