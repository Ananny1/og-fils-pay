# Laptop-only defaults so `docker compose up` in ops/ works on a fresh clone
# (the brief's instruction). Loaded FIRST by every service; ops/.env.docker,
# when present, is loaded after it and overrides any value here.
#
# NOT for a hosted box: there, ops/.env.docker must set NODE_ENV=production,
# OTP_DEV_EXPOSE=false and real secrets (see ops/.env.docker.example).
NODE_ENV=development
SETTLEMENT_INTERNAL_TOKEN=dev-only-settlement-token-not-for-production
WEBHOOK_SECRET_ENCRYPTION_KEY=ZGV2LW9ubHktd2ViaG9vay1rZXktbm90LWZvci1wcmQ=
ACQUIRER_CALLBACK_SIGNING_SECRET=dev-only-acquirer-secret-not-for-production
