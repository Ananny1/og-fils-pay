# HTTPS servers (TLS=on and /etc/letsencrypt/live/${WEB_DOMAIN}/ exists).
# One certificate covers both names: certbot -d ${WEB_DOMAIN} -d ${ADMIN_DOMAIN}.

# :80 only answers ACME challenges and redirects everything else to HTTPS.
server {
    listen 80 default_server;
    server_name ${WEB_DOMAIN} ${ADMIN_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }
    # The container healthcheck calls http://127.0.0.1/nginx-health; a redirect
    # to https://127.0.0.1 fails certificate checks and marks nginx unhealthy.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${WEB_DOMAIN};
    include /etc/nginx/conf.d/filspay-tls.inc;
    include /etc/nginx/conf.d/filspay-web-locations.inc;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};
    include /etc/nginx/conf.d/filspay-tls.inc;
    include /etc/nginx/conf.d/filspay-admin-locations.inc;
}
