# http-level settings shared by every FilsPay server block.
# Rendered by the nginx image's envsubst step (only ${VARS} that are set in
# the container environment are replaced).

# --- per-client limits (429 when exceeded) -------------------------------
# API in general: steady rate + burst per client IP.
limit_req_zone  $binary_remote_addr zone=fp_api:10m   rate=${NGINX_API_RATE};
# Login / OTP / signup: brute-force protection, much stricter.
limit_req_zone  $binary_remote_addr zone=fp_auth:10m  rate=${NGINX_AUTH_RATE};
# Open connections per client IP.
limit_conn_zone $binary_remote_addr zone=fp_conn:10m;
limit_req_status  429;
limit_conn_status 429;
limit_req_log_level warn;

# --- the API upstream ------------------------------------------------------
upstream filspay_api {
    zone filspay_api 64k;
    # `resolve` re-resolves the name, so a recreated API container is found.
    server api:3000 resolve max_fails=0;
    keepalive 32;
    keepalive_timeout 50s;   # below the API's own keepAliveTimeout (72 s)
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}
