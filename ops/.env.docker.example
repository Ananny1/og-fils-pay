# Copy to ops/.env.docker (git-ignored) and fill in real values.
# Loaded by every service in docker-compose.yml.
#
# Local:  NODE_ENV=development (dev OTP shown in the login response, insecure cookies OK on http)
# Hosted: NODE_ENV=production and OTP_DEV_EXPOSE=false
NODE_ENV=development
OTP_DEV_EXPOSE=true

# Shared by api (client) and settlement (server); must match.
SETTLEMENT_INTERNAL_TOKEN=change-me

# base64 of exactly 32 random bytes: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=

ACQUIRER_CALLBACK_SIGNING_SECRET=change-me
