# Copy to ops/.env.docker (git-ignored) and fill in real values.
# Loaded by every service in docker-compose.yml.
#
# These are the HOSTED values. For a laptop you don't need this file at all:
# ops/.env.dev already sets NODE_ENV=development and OTP_DEV_EXPOSE=true.
# OTP_DEV_EXPOSE=true is refused when NODE_ENV=production (BUG-031).
NODE_ENV=production
OTP_DEV_EXPOSE=false

#
# In production the api refuses to boot on any publicly known value: the
# "change-me" placeholders below, the ops/.env.dev values, and the acquirer
# secret leaked in git history (SEC-4). Generate fresh ones:
#   openssl rand -hex 32        (tokens / secrets)
#   openssl rand -base64 32     (encryption keys)

# Shared by api (client) and settlement (server); must match.
SETTLEMENT_INTERNAL_TOKEN=change-me

# base64 of exactly 32 random bytes: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Encrypts KYC files at rest; base64 of 32 random bytes. Falls back to the
# webhook key when empty — set a separate one.
KYC_ENCRYPTION_KEY=

# Must match the value configured on the acquirer side. Rotate together.
ACQUIRER_CALLBACK_SIGNING_SECRET=change-me

# Login codes by email (ENH-001). Without SMTP_HOST nobody can receive a
# login code on a hosted box. Gmail: an account with 2-Step Verification and
# an app password (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# The Gmail address that sends the codes.
SMTP_USER=
# Gmail app password (16 characters); never commit.
SMTP_PASSWORD=
MAIL_FROM="FilsPay <same-gmail-address@gmail.com>"

# The hosted API sits behind our reverse proxy (nginx): read the client IP
# from X-Forwarded-For, but only entries added by a proxy on the private
# compose network (default TRUST_PROXY_ADDRESSES=loopback,linklocal,uniquelocal).
# Leave unset/false when the API port is reached directly, or clients can
# fake their IP and dodge the login limits (SEC-1).
TRUST_PROXY=true

# Dashboard AI assistant (Sayed). Paste the key only into the real, git-ignored
# env file on the server; never commit it. Empty = assistant switched off (503).
ANTHROPIC_API_KEY=
# Hard limits: reply size, input size, history, data lookups, effort.
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_MAX_MESSAGE_CHARS=2000
ASSISTANT_MAX_HISTORY=12
ASSISTANT_MAX_TOOL_ROUNDS=3
ASSISTANT_EFFORT=low
# Paid AI calls per merchant: per minute and per day (ENH-009).
ASSISTANT_PER_MINUTE=6
ASSISTANT_PER_DAY=100
